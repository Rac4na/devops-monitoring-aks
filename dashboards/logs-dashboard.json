{
  "uid": "ms-logs",
  "title": "Microservicio - Logs y Requests (Loki + Prometheus)",
  "tags": [
    "loki",
    "microservicio",
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Líneas de log por minuto del microservicio (Loki)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({namespace=\"dev\", app=\"podinfo\"}[1m]))",
          "legendFormat": "logs/min"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests/s al microservicio por código HTTP (Prometheus)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total{namespace=\"dev\", app=\"podinfo\"}[2m]))",
          "legendFormat": "HTTP {{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Peticiones 404 por minuto detectadas en logs (Loki)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({namespace=\"dev\", app=\"podinfo\"} |= \"/status/404\" [1m]))",
          "legendFormat": "404/min"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Pods del microservicio en Running",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(kube_pod_status_phase{namespace=\"dev\", phase=\"Running\", pod=~\"podinfo.*\"})",
          "legendFormat": "Running"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Logs del microservicio podinfo (namespace dev)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 14
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"dev\", app=\"podinfo\"}"
        }
      ]
    }
  ]
}